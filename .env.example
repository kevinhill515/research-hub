# Copy this file to .env.local and fill in the values for your environment.
# .env.local is gitignored — per-machine and per-environment overrides stay
# out of source control.
#
# All VITE_-prefixed vars are embedded into the client bundle at build time,
# so values here are visible to anyone with the deployed site. That's fine
# for the publishable Supabase anon key (RLS-restricted on the server) but
# it's NOT a place for service-role keys or secrets.
#
# If these are unset, src/api/index.js falls back to the production project
# values so the default deploy keeps working.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxx
